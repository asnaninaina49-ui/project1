@model Notice
@{ ViewData["Title"] = "Delete Notice"; }
<div class="card border-danger shadow-sm"><div class="card-body p-4">
<h1 class="h2 text-danger">Delete notice?</h1><p>Are you sure you want to permanently delete this notice?</p>
<h2 class="h5">@Model.Title</h2><p class="text-muted">@Model.Category · @Model.PublishedOn.ToString("dd MMM yyyy")</p><p>@Model.Description</p>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Yes, delete</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
</div></div>
